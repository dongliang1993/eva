{
  "name": "@eva/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "build:server": "pnpm --filter @eva/server build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "pnpm run build:server && pnpm run build:electron",
    "pack": "pnpm run build && electron-builder --config electron-builder.yml",
    "pack:mac": "pnpm run pack -- --mac"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.27.0",
    "wait-on": "^9.0.0"
  }
}
