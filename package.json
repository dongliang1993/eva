{
  "name": "eva",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "pnpm --filter @eva/server --filter eva build",
    "serve:dev": "pnpm --filter @eva/server dev",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "web:dev": "pnpm --filter @eva/web -r dev",
    "web:build": "pnpm --filter @eva/web build",
    "desktop:dev": "pnpm --filter @eva/desktop dev",
    "desktop:build": "pnpm --filter @eva/desktop build",
    "desktop:pack": "pnpm --filter @eva/desktop pack"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "ai": "^7.0.64",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
