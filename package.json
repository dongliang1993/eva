{
  "name": "eva",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @eva/server --filter eva build",
    "lint:arch": "node scripts/check-architecture.mjs",
    "verify": "pnpm lint:arch && pnpm typecheck && pnpm test",
    "serve:dev": "pnpm --filter @eva/server dev",
    "test": "vitest run",
    "typecheck": "pnpm -r --if-present typecheck",
    "web:dev": "pnpm --filter @eva/web -r dev",
    "web:build": "pnpm --filter @eva/web build",
    "desktop:dev": "pnpm --filter @eva/desktop dev",
    "desktop:dev:all": "concurrently -n server,web,desktop -c blue,green,yellow \"pnpm serve:dev\" \"pnpm web:dev\" \"wait-on tcp:8082 tcp:5173 && pnpm desktop:dev\"",
    "desktop:build": "pnpm --filter @eva/desktop build",
    "desktop:pack": "pnpm --filter @eva/desktop run pack"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "ai": "^7.0.64",
    "concurrently": "^9.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "wait-on": "^9.0.0",
    "zod": "^3.25.76"
  }
}
